# Copy this file to .env and adjust values before running.

# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# --- Database ---
# When running via docker-compose, POSTGRES_SERVER should be "db" (the service name).
# When running the backend directly on your host against docker-compose's Postgres,
# use "127.0.0.1" — NOT "localhost" (some sandboxes fail to resolve it).
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=airguard
POSTGRES_PASSWORD=airguard_password
POSTGRES_DB=airguard_ai

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
# Set true only for local dev/testing without a running celery_worker —
# makes .delay() execute synchronously in-process instead of queuing.
CELERY_TASK_ALWAYS_EAGER=false

# --- Alert notification delivery ---
# Leave any of these blank to leave that channel unconfigured — the
# dispatcher will record it as "skipped" (not "failed") per recipient
# rather than error out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@airguard.ai
SMTP_USE_TLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

FCM_ACCESS_TOKEN=
FCM_PROJECT_ID=

# --- Route planning ---
# Gate coordinates on the 0-1000 plant-map canvas (see ParkingArea.map_x/map_y)
PLANT_GATE_X=0
PLANT_GATE_Y=500
ROUTE_HAZARD_BUFFER=90

# --- Weather intelligence ---
# Optional — leave blank to rely on manual/site-station ingestion only
WEATHER_API_BASE_URL=https://api.openweathermap.org
WEATHER_API_KEY=
WEATHER_SITE_LAT=
WEATHER_SITE_LON=

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Bootstrapped admin account (created automatically on first startup) ---
FIRST_SUPERUSER_EMAIL=admin@airguard.ai
FIRST_SUPERUSER_PASSWORD=ChangeMe123!
